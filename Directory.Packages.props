<Project>

  <!--
    Gestión centralizada de versiones de NuGet (T2-14): los .csproj declaran QUÉ paquetes usan y este
    archivo, con qué versión. Subir una dependencia se hace en un solo sitio y es imposible que dos
    proyectos queden en versiones distintas del mismo paquete.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <!-- Aplicación -->
    <PackageVersion Include="Microsoft.WindowsAppSDK" Version="1.8.260804001" />
    <PackageVersion Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
    <PackageVersion Include="H.NotifyIcon.WinUI" Version="2.4.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Pruebas. Se alinean en la versión más alta que ya usaba alguno de los dos proyectos. -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
    <!-- Cobertura en local (T4-04): el recolector va en el proyecto de tests; el informe HTML lo genera
         reportgenerator, declarado como herramienta local en .config/dotnet-tools.json. -->
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />
    <PackageVersion Include="FlaUI.Core" Version="5.0.0" />
    <PackageVersion Include="FlaUI.UIA3" Version="5.0.0" />
  </ItemGroup>

</Project>
