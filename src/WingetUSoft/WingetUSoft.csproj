<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Platforms>x64;ARM64</Platforms>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Version>1.8.8</Version>
    <AssemblyVersion>1.8.8.0</AssemblyVersion>
    <FileVersion>1.8.8.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <PackageReference Include="H.NotifyIcon.WinUI" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>WingetUSoft.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <!-- Textos legales mostrados dentro de la app (Ayuda -> Licencia / Avisos de terceros). -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\LICENSE" LogicalName="WingetUSoft.LICENSE.txt" />
    <EmbeddedResource Include="..\..\THIRD-PARTY-NOTICES.txt" LogicalName="WingetUSoft.THIRD-PARTY-NOTICES.txt" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\app.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Copia .xbf y .pri del proyecto al output de publish (workaround WinUI 3 unpackaged) -->
  <Target Name="CopyXamlResourcesToPublish" AfterTargets="Publish">
    <PropertyGroup>
      <_BuildOutput>$(OutputPath)</_BuildOutput>
    </PropertyGroup>
    <ItemGroup>
      <_XbfFiles Include="$(_BuildOutput)**\*.xbf" />
      <_AppPri Include="$(_BuildOutput)WingetUSoft.pri" />
    </ItemGroup>
    <Copy SourceFiles="@(_AppPri)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_XbfFiles)" DestinationFiles="@(_XbfFiles->'$(PublishDir)%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Message Importance="high" Text="Copied XBF and PRI resources to publish output." />
  </Target>


  <!--
    T2-03 — Fuera el runtime de IA del paquete publicado.

    Con WindowsAppSDKSelfContained, la SDK copia al publish TODA su carga útil, incluida la pila de IA
    en el equipo: onnxruntime.dll (20,6 MB), DirectML.dll (17,7 MB) y los Microsoft.Windows.AI.* (~2,6
    MB). Son ~41 MB de los 142 del publish. Esta app gestiona paquetes de winget: no referencia ni una
    de esas APIs (comprobado por grep sobre todo el código fuente), así que el usuario se descargaba
    ese peso en cada actualización para nada.

    Se filtra por NOMBRE y después de los targets que componen la carga útil, en vez de por la vía
    "oficial" (el item MicrosoftWindowsAppSDKFilesExcluded que esos targets consultan): ese item hay
    que rellenarlo con rutas completas derivadas de WindowsAppSdkComponentPackages, que la SDK define
    dentro de sus propios targets y no está disponible al evaluar el proyecto. Filtrar por nombre a
    posteriori no depende de en qué paquete de componentes viva cada archivo.

    Si algún día la app usa Windows AI Foundation, basta con borrar este bloque.
  -->
  <Target Name="RemoveUnusedAIRuntime"
          AfterTargets="AddMicrosoftWindowsAppSDKPayloadFilesFromMsix;AddMicrosoftWindowsAppSDKPayloadFilesFromComponents">
    <ItemGroup>
      <None Remove="@(None)"
            Condition="'%(Filename)' == 'onnxruntime'
                    or '%(Filename)' == 'onnxruntime_providers_shared'
                    or '%(Filename)' == 'DirectML'
                    or '%(Filename)' == 'Microsoft.ML.OnnxRuntime'
                    or $([System.String]::Copy('%(Filename)').StartsWith('Microsoft.Windows.AI'))" />
    </ItemGroup>
  </Target>

</Project>