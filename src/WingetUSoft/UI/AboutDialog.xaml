<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="WingetUSoft.AboutDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Style="{StaticResource DefaultContentDialogStyle}">

    <!-- El estilo moderno de ContentDialog es implícito y no alcanza a las subclases definidas en XAML: sin
         esta línea, el diálogo usaba la plantilla antigua (contenido y botones en una sola franja plana) y
         necesitaba parches de CornerRadius en el diálogo y en cada botón (F-12). -->

    <ScrollViewer MaxHeight="420" VerticalScrollBarVisibility="Auto"
                  HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="400" Spacing="8">
            <TextBlock Text="WingetUSoft" FontWeight="SemiBold" FontSize="18"
                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
            <TextBlock x:Name="VersionText" Opacity="0.7" FontSize="12" />
            <TextBlock x:Name="DescText" TextWrapping="Wrap" FontSize="13" />
            <TextBlock x:Name="CopyrightText" TextWrapping="Wrap" FontSize="12" Opacity="0.85" />

            <Border Height="1" Margin="0,4"
                    Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

            <TextBlock x:Name="PrivacyHeader" FontWeight="SemiBold" FontSize="13" />
            <TextBlock x:Name="PrivacyText" TextWrapping="Wrap" FontSize="12" Opacity="0.9" />
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
