<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WingetUSoft.CleanupWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WingetUSoft"
    Title="WingetUSoft - Limpieza de residuos">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom Title Bar -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="32" Background="Transparent">
            <TextBlock x:Name="txtTitleBar" Text="Limpieza de residuos"
                       VerticalAlignment="Center"
                       Margin="12,0,0,0"
                       Style="{StaticResource CaptionTextBlockStyle}" />
        </Grid>

        <!-- Main Content -->
        <Grid Grid.Row="1" Padding="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Barra de acciones. El resumen del escaneo y el aviso vivían en una tarjeta de cabecera junto al título
                 de la ventana, que ya lo dice la barra de título (F-17): se quedan aquí, debajo de los botones. -->
            <Border Grid.Row="1" Style="{StaticResource CompactCardStyle}"
                    Margin="0,0,0,8">
                <StackPanel Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="btnEscanear"
                            Content="Volver a escanear"
                            Click="BtnEscanear_Click"
                            MinWidth="160" Height="32" />
                    <Button x:Name="btnEliminar"
                            Click="BtnEliminar_Click"
                            IsEnabled="False"
                            MinWidth="190" Height="32">
                        <Button.Resources>
                            <ResourceDictionary>
                                <ResourceDictionary.MergedDictionaries>
                                    <ResourceDictionary Source="ms-appx:///UI/DangerButtonResources.xaml" />
                                </ResourceDictionary.MergedDictionaries>
                            </ResourceDictionary>
                        </Button.Resources>
                        <!-- Papelera: el peligro no se comunica solo con el color (WCAG 1.4.1). -->
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE74D;" FontSize="14" />
                            <TextBlock x:Name="txtEliminarLabel" Text="Eliminar seleccionados" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="btnSelAll"
                            Content="Seleccionar todo"
                            Click="BtnSelAll_Click"
                            Height="32" />
                    <Button x:Name="btnDeselAll"
                            Content="Deseleccionar todo"
                            Click="BtnDeselAll_Click"
                            Height="32" />
                    <Button x:Name="btnCancelar"
                            Content="Cancelar"
                            Click="BtnCancelar_Click"
                            IsEnabled="False"
                            Height="32" />
                </StackPanel>
                    <TextBlock x:Name="txtSubtitulo"
                               Text="Buscando residuos..."
                               Style="{StaticResource BodyTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="txtWarning" Text="⚠ Verifica cuidadosamente cada elemento antes de eliminar. Esta acción no se puede deshacer."
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource SystemFillColorCautionBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- Main split: List + Log. El registro va plegado y su fila es Auto hasta que se despliega (LogExpander,
                 F-17): "Actividad" suele estar vacía salvo durante la limpieza; plegado, solo ocupa su cabecera. -->
            <Grid Grid.Row="2" Margin="0,0,0,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="3*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition x:Name="rowLog" Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Residuals List Card -->
                <Border Grid.Row="0" Style="{StaticResource TableCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Column Headers -->
                        <Grid Grid.Row="0" Style="{StaticResource TableHeaderStyle}" Height="36"
                              Padding="8,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="160" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" VerticalAlignment="Center" />
                            <TextBlock x:Name="colRuta" Grid.Column="1" Text="Ruta" VerticalAlignment="Center" FontWeight="SemiBold" Margin="4,0,0,0"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="colTipo" Grid.Column="2" Text="Tipo" VerticalAlignment="Center" FontWeight="SemiBold" Margin="8,0,0,0"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="colTamano" Grid.Column="3" Text="Tamaño" VerticalAlignment="Center" FontWeight="SemiBold" Margin="8,0,0,0"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="colPrograma" Grid.Column="4" Text="Programa" VerticalAlignment="Center" FontWeight="SemiBold" Margin="8,0,0,0"
                                       TextTrimming="CharacterEllipsis" />
                        </Grid>

                        <ListView x:Name="lvItems" ItemContainerStyle="{StaticResource TableRowContainerStyle}"
                                  Grid.Row="1"
                                  SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="38" Padding="8,0"
                                          AutomationProperties.Name="{Binding RowLabel}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="160" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0"
                                                  AutomationProperties.Name="{Binding SelectLabel}"
                                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  Checked="OnItemCheckChanged"
                                                  Unchecked="OnItemCheckChanged"
                                                  VerticalAlignment="Center"
                                                  Padding="0" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Path}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="4,0,0,0"
                                                   ToolTipService.ToolTip="{Binding Path}" />
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding TypeLabel}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="8,0,0,0" />
                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding DisplaySize}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="8,0,0,0"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Grid.Column="4"
                                                   Text="{Binding PackageName}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="8,0,0,0"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <!-- Estado de la lista: cargando, vacía o con error (F-18). Encima del ListView, no en su lugar. -->
                        <local:ListStatePanel x:Name="panelListState"
                                              Grid.Row="1"
                                              ActionInvoked="PanelListState_ActionInvoked" />
                    </Grid>
                </Border>

                <!-- Splitter -->
                <Border Grid.Row="1" Height="6" Background="Transparent" />

                <!-- Log Card -->
                <!-- Registro plegable (F-17): se abre solo al empezar la operación y ante un error (LogExpander). -->
                <Expander x:Name="expLog"
                          Grid.Row="2"
                          Header="Actividad"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          HorizontalContentAlignment="Stretch"
                          VerticalContentAlignment="Stretch"
                          Padding="12">
                    <local:ActivityLog x:Name="activityLog" MaxLines="200" />
                </Expander>
            </Grid>

            <!-- Status Bar -->
            <Border Grid.Row="3" Style="{StaticResource CompactCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="txtEstado"
                               Grid.Column="0"
                               Text="Listo."
                               Style="{StaticResource BodyStrongTextBlockStyle}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />
                    <ProgressRing x:Name="progressRing"
                                  Grid.Column="1"
                                  IsActive="False"
                                  Width="20" Height="20"
                                  Margin="12,0,0,0" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
