<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="WingetUSoft.WhatsNewDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Style="{StaticResource DefaultContentDialogStyle}">

    <!-- El estilo moderno de ContentDialog es implícito y no alcanza a las subclases definidas en XAML: sin
         esta línea, el diálogo usaba la plantilla antigua (contenido y botones en una sola franja plana) y
         necesitaba parches de CornerRadius en el diálogo y en cada botón (F-12). -->

    <StackPanel MaxWidth="380" Spacing="10">
        <TextBlock x:Name="VersionText" FontWeight="SemiBold"
                   Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
        <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
            <TextBlock x:Name="NotesText" TextWrapping="Wrap" FontSize="13" />
        </ScrollViewer>
    </StackPanel>
</ContentDialog>
