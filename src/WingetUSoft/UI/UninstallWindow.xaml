<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WingetUSoft.UninstallWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WingetUSoft"
    Title="WingetUSoft - Desinstalar programas">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.Resources>
            <local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom Title Bar -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="32" Background="Transparent">
            <TextBlock x:Name="txtTitleBar" Text="Desinstalar programas"
                       VerticalAlignment="Center"
                       Margin="12,0,0,0"
                       Style="{StaticResource CaptionTextBlockStyle}" />
        </Grid>

        <!-- Main Content -->
        <Grid Grid.Row="1" Padding="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Actions + Search Bar. Botones y buscador comparten línea y el WrapPanel baja el buscador a la siguiente
                 solo si no cabe (F-17): en dos líneas fijas, a 900×700 la lista se quedaba en nueve filas. Cada par
                 etiqueta + control va en su StackPanel para saltar de línea junto. -->
            <Border Grid.Row="1" Style="{StaticResource CompactCardStyle}"
                    Margin="0,0,0,8">
                <local:WrapPanel HorizontalSpacing="8" VerticalSpacing="8">
                        <Button x:Name="btnRefresh"
                                Content="Actualizar lista"
                                Click="BtnRefresh_Click"
                                Height="32" />
                        <Button x:Name="btnUninstall"
                                Click="BtnUninstall_Click"
                                IsEnabled="False"
                                Height="32">
                            <Button.Resources>
                                <ResourceDictionary>
                                    <ResourceDictionary.MergedDictionaries>
                                        <ResourceDictionary Source="ms-appx:///UI/DangerButtonResources.xaml" />
                                    </ResourceDictionary.MergedDictionaries>
                                </ResourceDictionary>
                            </Button.Resources>
                            <!-- Papelera: el peligro no se comunica solo con el color (WCAG 1.4.1). -->
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                <TextBlock x:Name="txtUninstallLabel" Text="Desinstalar seleccionado" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="btnCancelar"
                                Content="Cancelar"
                                Click="BtnCancelar_Click"
                                IsEnabled="False"
                                Height="32" />
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="8,0,0,0">
                        <TextBlock x:Name="txtBuscarLabel" Text="Buscar:" VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBox x:Name="txtBuscar"
                                 PlaceholderText="Nombre o Id..."
                                 Width="220" Height="32"
                                 VerticalAlignment="Center"
                                 AutomationProperties.LabeledBy="{Binding ElementName=txtBuscarLabel}"
                                 TextChanged="TxtBuscar_TextChanged" />
                        <TextBlock x:Name="txtContador"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </local:WrapPanel>
            </Border>

            <!-- Main Split: List + Log. El registro va plegado y su fila es Auto hasta que se despliega (LogExpander,
                 F-17): "Actividad" suele estar vacía salvo durante una desinstalación; plegado, solo ocupa su cabecera. -->
            <Grid Grid.Row="2" Margin="0,0,0,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="3*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition x:Name="rowLog" Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Installed Packages Card -->
                <Border Grid.Row="0" Style="{StaticResource TableCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Column Headers -->
                        <Grid Grid.Row="0" Style="{StaticResource TableHeaderStyle}" Height="36"
                              Padding="8,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="80" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="colNombre" Grid.Column="0" Text="Nombre" VerticalAlignment="Center" FontWeight="SemiBold" Margin="4,0,0,0"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="colId" Grid.Column="1" Text="Id" VerticalAlignment="Center" FontWeight="SemiBold" Margin="8,0,0,0"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="colVersion" Grid.Column="2" Text="Versión" VerticalAlignment="Center" FontWeight="SemiBold" Margin="8,0,0,0"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="colFuente" Grid.Column="3" Text="Fuente" VerticalAlignment="Center" FontWeight="SemiBold" Margin="8,0,0,0"
                                       TextTrimming="CharacterEllipsis" />
                        </Grid>

                        <ListView x:Name="lvPackages" ItemContainerStyle="{StaticResource TableRowContainerStyle}"
                                  Grid.Row="1"
                                  SelectionMode="Single"
                                  SelectionChanged="LvPackages_SelectionChanged">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="36" Padding="8,0"
                                          AutomationProperties.Name="{Binding RowLabel}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="220" />
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="80" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Center"
                                                   ToolTipService.ToolTip="{Binding Name}"
                                                   TextTrimming="CharacterEllipsis" Margin="4,0,0,0" />
                                        <TextBlock Grid.Column="1" Text="{Binding Id}" VerticalAlignment="Center"
                                                   ToolTipService.ToolTip="{Binding Id}"
                                                   TextTrimming="CharacterEllipsis" Margin="8,0,0,0" />
                                        <TextBlock Grid.Column="2" Text="{Binding VersionText}" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" Margin="8,0,0,0" />
                                        <TextBlock Grid.Column="3" Text="{Binding Source}" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" Margin="8,0,0,0"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <!-- Estado de la lista: cargando, vacía o con error (F-18). Encima del ListView, no en su lugar. -->
                        <local:ListStatePanel x:Name="panelListState"
                                              Grid.Row="1"
                                              ActionInvoked="PanelListState_ActionInvoked" />
                    </Grid>
                </Border>

                <!-- Splitter -->
                <Border Grid.Row="1" Height="6" Background="Transparent" />

                <!-- Log Card -->
                <!-- Registro plegable (F-17): se abre solo al empezar la operación y ante un error (LogExpander). -->
                <Expander x:Name="expLog"
                          Grid.Row="2"
                          Header="Actividad"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          HorizontalContentAlignment="Stretch"
                          VerticalContentAlignment="Stretch"
                          Padding="12">
                    <local:ActivityLog x:Name="activityLog" MaxLines="200" />
                </Expander>
            </Grid>

            <!-- Status Bar -->
            <Border Grid.Row="3" Style="{StaticResource CompactCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="txtEstado"
                               Grid.Column="0"
                               Text="Listo."
                               Style="{StaticResource BodyStrongTextBlockStyle}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />
                    <ProgressRing x:Name="progressRing"
                                  Grid.Column="1"
                                  IsActive="False"
                                  Width="20" Height="20"
                                  Margin="12,0,0,0" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
