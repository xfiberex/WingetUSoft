<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WingetUSoft.UninstallWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WingetUSoft"
    Title="WingetUSoft - Desinstalar programas">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.Resources>
            <local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom Title Bar -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="32" Background="Transparent">
            <TextBlock x:Name="txtTitleBar" Text="Desinstalar programas"
                       VerticalAlignment="Center"
                       Margin="12,0,0,0"
                       Style="{StaticResource CaptionTextBlockStyle}" />
        </Grid>

        <!-- Main Content -->
        <Grid Grid.Row="1" Padding="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header Card -->
            <Border Grid.Row="0"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20,16"
                    Margin="0,0,0,12">
                <StackPanel Spacing="4">
                    <TextBlock x:Name="txtHeaderTitle" Text="Desinstalar programas instalados"
                               Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock x:Name="txtSubtitulo"
                               Text="Selecciona un programa de la lista y pulsa Desinstalar."
                               Style="{StaticResource BodyTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>

            <!-- Actions + Search Bar -->
            <Border Grid.Row="1"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16,12"
                    Margin="0,0,0,12">
                <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="btnRefresh"
                                Content="Actualizar lista"
                                Click="BtnRefresh_Click"
                                MinWidth="160" Height="36" />
                        <Button x:Name="btnUninstall"
                                Click="BtnUninstall_Click"
                                IsEnabled="False"
                                MinWidth="200" Height="36">
                            <Button.Resources>
                                <ResourceDictionary>
                                    <ResourceDictionary.MergedDictionaries>
                                        <ResourceDictionary Source="ms-appx:///UI/DangerButtonResources.xaml" />
                                    </ResourceDictionary.MergedDictionaries>
                                </ResourceDictionary>
                            </Button.Resources>
                            <!-- Papelera: el peligro no se comunica solo con el color (WCAG 1.4.1). -->
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                <TextBlock x:Name="txtUninstallLabel" Text="Desinstalar seleccionado" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="btnCancelar"
                                Content="Cancelar"
                                Click="BtnCancelar_Click"
                                IsEnabled="False"
                                MinWidth="100" Height="36" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <TextBlock x:Name="txtBuscarLabel" Text="Buscar:" VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBox x:Name="txtBuscar"
                                 PlaceholderText="Nombre o Id..."
                                 Width="260" Height="32"
                                 VerticalAlignment="Center"
                                 AutomationProperties.LabeledBy="{Binding ElementName=txtBuscarLabel}"
                                 TextChanged="TxtBuscar_TextChanged" />
                        <TextBlock x:Name="txtContador"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Main Split: List + Log. La lista pesa 3* frente a 1* del log: "Actividad" suele estar
                 vacía salvo durante una desinstalación, y no debe robar sitio a la lista de programas. -->
            <Grid Grid.Row="2" Margin="0,0,0,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="3*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MinHeight="90" />
                </Grid.RowDefinitions>

                <!-- Installed Packages Card -->
                <Border Grid.Row="0"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock x:Name="txtListHeader" Grid.Row="0"
                                   Text="Programas instalados"
                                   Style="{StaticResource BodyStrongTextBlockStyle}"
                                   Margin="4,0,0,8" />

                        <!-- Column Headers -->
                        <Grid Grid.Row="1" Height="36"
                              Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                              CornerRadius="4,4,0,0"
                              Padding="8,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="80" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="colNombre" Grid.Column="0" Text="Nombre" VerticalAlignment="Center" FontWeight="SemiBold" Margin="4,0,0,0"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="colId" Grid.Column="1" Text="Id" VerticalAlignment="Center" FontWeight="SemiBold" Margin="8,0,0,0"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="colVersion" Grid.Column="2" Text="Versión" VerticalAlignment="Center" FontWeight="SemiBold" Margin="8,0,0,0"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="colFuente" Grid.Column="3" Text="Fuente" VerticalAlignment="Center" FontWeight="SemiBold" Margin="8,0,0,0"
                                       TextTrimming="CharacterEllipsis" />
                        </Grid>

                        <ListView x:Name="lvPackages"
                                  Grid.Row="2"
                                  SelectionMode="Single"
                                  SelectionChanged="LvPackages_SelectionChanged">
                            <!-- El ListViewItem trae Padding="16,0,12,0" por defecto y la cabecera no lo replica: sin esto,
                                 la primera columna quedaba 16 px a la derecha de su cabecera y el resto 12 px a la izquierda
                                 (F-07). El margen lo pone la propia fila, igual que la cabecera. -->
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="36" Padding="8,0"
                                          AutomationProperties.Name="{Binding RowLabel}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="220" />
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="80" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" Margin="4,0,0,0" />
                                        <TextBlock Grid.Column="1" Text="{Binding Id}" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" Margin="8,0,0,0" />
                                        <TextBlock Grid.Column="2" Text="{Binding Version}" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" Margin="8,0,0,0" />
                                        <TextBlock Grid.Column="3" Text="{Binding Source}" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" Margin="8,0,0,0"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>

                <!-- Splitter -->
                <Border Grid.Row="1" Height="6" Background="Transparent" />

                <!-- Log Card -->
                <Border Grid.Row="2"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="txtLogHeader" Grid.Row="0"
                                   Text="Actividad"
                                   Style="{StaticResource BodyStrongTextBlockStyle}"
                                   Margin="4,0,0,8" />
                        <local:ActivityLog x:Name="activityLog"
                                             Grid.Row="1"
                                             MaxLines="200" />
                    </Grid>
                </Border>
            </Grid>

            <!-- Status Bar -->
            <Border Grid.Row="3"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="txtEstado"
                               Grid.Column="0"
                               Text="Listo."
                               Style="{StaticResource BodyStrongTextBlockStyle}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />
                    <ProgressRing x:Name="progressRing"
                                  Grid.Column="1"
                                  IsActive="False"
                                  Width="20" Height="20"
                                  Margin="12,0,0,0" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
