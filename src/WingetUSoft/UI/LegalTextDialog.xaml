<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="WingetUSoft.LegalTextDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Style="{StaticResource DefaultContentDialogStyle}">

    <!-- El estilo moderno de ContentDialog es implícito y no alcanza a las subclases definidas en XAML: sin
         esta línea, el diálogo usaba la plantilla antigua (contenido y botones en una sola franja plana) y
         necesitaba parches de CornerRadius en el diálogo y en cada botón (F-12). -->

    <ScrollViewer MinWidth="360" MaxWidth="460" MaxHeight="420"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
        <TextBlock x:Name="BodyText" TextWrapping="Wrap" FontSize="12"
                   FontFamily="Consolas" IsTextSelectionEnabled="True" />
    </ScrollViewer>
</ContentDialog>
