<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WingetUSoft.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WingetUSoft"
    Title="WingetUSoft - Actualiza tus programas">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.Resources>
            <local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />

            <!-- Celdas de texto de la tabla. La atenuada (paquete excluido u omitido) usa el gris secundario del
                 tema en lugar de Opacity: con Opacity 0.4 el texto caía a 2,50:1 en claro y 3,59:1 en oscuro
                 (F-06). El pincel va en un estilo y no en un convertidor porque un {ThemeResource} solo sigue el
                 tema forzado de la ventana si lo resuelve el propio elemento; Application.Current.Resources
                 devolvería el del sistema (el mismo problema que T1-04). -->
            <Style x:Key="PackageCellTextStyle" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="Margin" Value="8,0,0,0" />
            </Style>
            <Style x:Key="DimmedPackageCellTextStyle" TargetType="TextBlock" BasedOn="{StaticResource PackageCellTextStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
            <local:BoolToObjectConverter x:Key="PackageCellStyleConverter"
                                         TrueValue="{StaticResource DimmedPackageCellTextStyle}"
                                         FalseValue="{StaticResource PackageCellTextStyle}" />

        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Custom Title Bar -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="32" Background="Transparent">
            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="12,0,0,0"
                        Spacing="8">
                <Image x:Name="TitleBarIcon"
                       Width="16"
                       Height="16"
                       VerticalAlignment="Center" />
                <TextBlock x:Name="TitleTextBlock"
                           Text="WingetUSoft"
                           VerticalAlignment="Center"
                           Style="{StaticResource CaptionTextBlockStyle}" />
            </StackPanel>
        </Grid>

        <!-- Main Content -->
        <!-- Todo el contenido vive dentro de un ScrollViewer vertical: en ventanas muy bajas (snap
             a cuarto de pantalla de Windows 11) las tarjetas superiores no dejaban ni un pixel a la
             tabla, que quedaba recortada entera fuera de la ventana (Tier B #7).
             Height atado al viewport y MinHeight calculado en código (UpdateContentMinHeight) dan los dos
             comportamientos: si sobra alto, el Grid mide lo mismo que el viewport y la fila * tiene un alto
             finito, así que la tabla desplaza por sí misma; si falta, manda MinHeight (tarjetas superiores +
             el piso de la tabla) y desplaza la página. Hasta F-01 era MinHeight atado al viewport sin Height:
             el ScrollViewer mide con alto infinito, la fila * se comportaba como Auto y la tabla se medía
             entera, sin scroll propio ni virtualización, empujando el registro fuera de la ventana. -->
        <ScrollViewer Grid.Row="1"
                      x:Name="ContentScroller"
                      VerticalScrollBarVisibility="Auto"
                      VerticalScrollMode="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      HorizontalScrollMode="Disabled">
            <Grid x:Name="ContentGrid"
                  Padding="16"
                  Height="{Binding ViewportHeight, ElementName=ContentScroller}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <!-- Piso de la zona tabla+log: por debajo de esto el ScrollViewer desplaza la
                         página en vez de seguir encogiendo la tabla hasta hacerla inservible. -->
                    <RowDefinition Height="*" MinHeight="300" />
                </Grid.RowDefinitions>

                <!-- Aviso de versión nueva, a lo alto del contenido y no dentro de la tarjeta de cabecera (F-22):
                     es un estado de la aplicación, no parte de su título. El mensaje se queda en una línea y el
                     changelog entero va a un clic, en «Ver novedades». -->
                <InfoBar x:Name="infoBarUpdate"
                         Grid.Row="0"
                         IsOpen="False"
                         Severity="Informational"
                         IsClosable="True"
                         Margin="0,0,0,12">
                    <InfoBar.Content>
                        <StackPanel Margin="0,0,0,4" Spacing="4">
                            <HyperlinkButton x:Name="lnkVerNovedades"
                                             Content="Ver novedades"
                                             Padding="0,4"
                                             Click="LnkVerNovedades_Click" />
                            <ProgressBar x:Name="pbUpdate"
                                         Visibility="Collapsed"
                                         Minimum="0" Maximum="1"
                                         IsIndeterminate="False" />
                        </StackPanel>
                    </InfoBar.Content>
                    <InfoBar.ActionButton>
                        <Button x:Name="btnInstalarUpdate"
                                Content="Instalar ahora"
                                Click="LnkDescargarUpdate_Click" />
                    </InfoBar.ActionButton>
                </InfoBar>

                <!-- Header Card -->
                <Border Grid.Row="1" Style="{StaticResource HeaderCardStyle}"
                        Margin="0,0,0,12">
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="txtHeaderTitle"
                                   Text="Actualiza tus programas con winget"
                                   Style="{StaticResource TitleTextBlockStyle}" />
                        <TextBlock x:Name="txtSubtitulo"
                                   Text="Consulta, filtra y actualiza paquetes desde una sola vista."
                                   Style="{StaticResource BodyTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>

                <!-- Actions Bar -->
                <Border Grid.Row="2" Style="{StaticResource CardStyle}"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock x:Name="txtAccionesTitle" Text="Acciones rápidas"
                                   Style="{StaticResource BodyStrongTextBlockStyle}"
                                   Margin="0,0,0,8" />
                        <!-- Cada atajo cuelga del control que ejecuta (F-21): así su tooltip sale solo al pasar
                             por ese control y no por toda la ventana, como cuando colgaban de Content. Un
                             acelerador sin Invoked que lo marque Handled ejecuta el Click del botón, y uno sobre
                             un control deshabilitado no se dispara: F5 y Esc ya no necesitan guardas propias.
                             AutomationProperties.AcceleratorKey no lo rellena WinUI a partir del acelerador: sin él,
                             el Narrador no anunciaría la tecla. -->
                        <local:WrapPanel HorizontalSpacing="8" VerticalSpacing="8">
                            <!-- Una sola acción, «Consultar», con su variante en el desplegable (F-23): eran dos botones
                                 hermanos para lo mismo, y el de al lado ganaba el mismo peso visual. El botón principal
                                 repite la última variante elegida, que es la que rotula. -->
                            <SplitButton x:Name="btnConsultar"
                                         Content="Consultar actualizaciones"
                                         Click="BtnConsultar_Click"
                                         AutomationProperties.AcceleratorKey="F5"
                                         MinWidth="180" Height="36">
                                <SplitButton.KeyboardAccelerators>
                                    <KeyboardAccelerator Key="F5" Invoked="RefreshAccelerator_Invoked" />
                                </SplitButton.KeyboardAccelerators>
                                <SplitButton.Flyout>
                                    <MenuFlyout Placement="Bottom">
                                        <RadioMenuFlyoutItem x:Name="menuConsultarNormal"
                                                             Text="Consultar actualizaciones"
                                                             GroupName="ModoConsulta"
                                                             IsChecked="True"
                                                             Click="MenuConsultarNormal_Click" />
                                        <RadioMenuFlyoutItem x:Name="menuConsultarDesconocidas"
                                                             Text="Consultar con desconocidas"
                                                             GroupName="ModoConsulta"
                                                             Click="MenuConsultarDesconocidas_Click" />
                                    </MenuFlyout>
                                </SplitButton.Flyout>
                            </SplitButton>
                            <Button x:Name="btnActualizarSeleccionados"
                                    Content="Actualizar seleccionados"
                                    Click="BtnActualizarSeleccionados_Click"
                                    MinWidth="180" Height="36" />
                            <Button x:Name="btnActualizarTodo"
                                    Content="Actualizar todo"
                                    Click="BtnActualizarTodo_Click"
                                    MinWidth="140" Height="36" />
                            <!-- Cancelar NO es destructivo: interrumpe un lote, no borra nada. Vestirlo de
                                 rojo (como iba hasta v1.5.0) lo confundía con el peligro real, que en esta
                                 app son Desinstalar y Eliminar (DangerButtonResources.xaml). Es un botón normal. -->
                            <Button x:Name="btnCancelar"
                                    Content="Cancelar"
                                    Click="BtnCancelar_Click"
                                    IsEnabled="False"
                                    AutomationProperties.AcceleratorKey="Esc"
                                    MinWidth="120" Height="36">
                                <Button.KeyboardAccelerators>
                                    <KeyboardAccelerator Key="Escape" />
                                </Button.KeyboardAccelerators>
                            </Button>

                            <!-- Solo ACCIONES. Las preferencias (modo, tema, idioma) se mudaron a la
                                 ventana de Configuración, donde ya vivía el resto (Tier C #5). -->
                            <DropDownButton x:Name="btnHerramientas" Content="Herramientas" Height="36" MinWidth="120">
                                <DropDownButton.Flyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem x:Name="menuExportar" Text="Exportar lista..." Click="MenuExportar_Click">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xEDE1;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem x:Name="menuConfiguracion" Text="Configuración..." Click="MenuConfiguracion_Click">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE713;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem x:Name="menuBuscarInstalar" Text="Buscar e instalar programas..." Click="MenuBuscarInstalar_Click">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE721;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem x:Name="menuExportarWinget" Text="Exportar paquetes (winget)..." Click="MenuExportarWinget_Click">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xEDE1;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem x:Name="menuImportarWinget" Text="Importar paquetes (winget)..." Click="MenuImportarWinget_Click">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE896;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem x:Name="menuVerHistorial" Text="Ver historial" Click="MenuHistorial_Click">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE81C;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem x:Name="menuDesinstalar" Text="Desinstalar programas..." Click="MenuDesinstalar_Click">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE74D;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </DropDownButton.Flyout>
                            </DropDownButton>

                            <!-- Help menu -->
                            <DropDownButton x:Name="btnAyuda" Content="Ayuda" Height="36" MinWidth="90">
                                <DropDownButton.Flyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem x:Name="menuBuscarActualizacion"
                                                        Text="Buscar actualización de WingetUSoft..."
                                                        Click="MenuBuscarActualizacion_Click">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE777;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem x:Name="menuWhatsNew" Text="Novedades..." Click="MenuWhatsNew_Click">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE789;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem x:Name="menuLicencia" Text="Licencia" Click="MenuLicencia_Click">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE8A5;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem x:Name="menuAvisosTerceros" Text="Avisos de terceros" Click="MenuAvisosTerceros_Click">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE7BE;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem x:Name="menuAcercaDe" Text="Acerca de..." Click="MenuAcercaDe_Click">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE946;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </DropDownButton.Flyout>
                            </DropDownButton>
                        </local:WrapPanel>
                    </StackPanel>
                </Border>

                <!-- Source Filter + Search + Package Info -->
                <Border Grid.Row="3" Style="{StaticResource CompactCardStyle}"
                        Margin="0,0,0,8">
                    <StackPanel Spacing="8">
                        <!-- Filters row. WrapPanel y no StackPanel horizontal: con anchos fijos (200 + 200)
                             la fila pide ~850 px y el mínimo de ventana son 900 DIP, así que a 150 % de DPI o
                             con etiquetas FR/IT el cuadro de búsqueda quedaba recortado y sin scroll con el
                             que alcanzarlo (el ScrollViewer que la contiene lleva HorizontalScrollMode="Disabled").
                             Cada etiqueta va con su control dentro de un StackPanel para que el par salte de
                             fila junto y la etiqueta nunca quede huérfana al final de la anterior. -->
                        <local:WrapPanel HorizontalSpacing="12" VerticalSpacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock x:Name="txtFuenteLabel" Text="Fuente:" VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <ComboBox x:Name="cmbFuente" Width="200"
                                          AutomationProperties.LabeledBy="{Binding ElementName=txtFuenteLabel}"
                                          SelectionChanged="CmbFuente_SelectionChanged">
                                    <ComboBoxItem x:Name="cmbFuenteAllItem" Content="Todas las fuentes" IsSelected="True" />
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock x:Name="txtExcluidosLabel" Text="Excluidos:" VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <DropDownButton x:Name="btnFiltroExcluidos" Content="Todos" Height="32" MinWidth="130"
                                                AutomationProperties.LabeledBy="{Binding ElementName=txtExcluidosLabel}">
                                    <DropDownButton.Flyout>
                                        <MenuFlyout>
                                            <RadioMenuFlyoutItem x:Name="menuFiltroTodos" Text="Todos" IsChecked="True"
                                                                 GroupName="FiltroExcluidos" Click="MenuFiltroTodos_Click" />
                                            <RadioMenuFlyoutItem x:Name="menuFiltroNoExcluidos" Text="No excluidos"
                                                                 GroupName="FiltroExcluidos" Click="MenuFiltroNoExcluidos_Click" />
                                            <RadioMenuFlyoutItem x:Name="menuFiltroSoloExcluidos" Text="Solo excluidos"
                                                                 GroupName="FiltroExcluidos" Click="MenuFiltroSoloExcluidos_Click" />
                                        </MenuFlyout>
                                    </DropDownButton.Flyout>
                                </DropDownButton>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock x:Name="txtBuscarLabel" Text="Buscar:" VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBox x:Name="txtBuscar"
                                         PlaceholderText="Nombre o Id..."
                                         Width="200" Height="32"
                                         VerticalAlignment="Center"
                                         AutomationProperties.LabeledBy="{Binding ElementName=txtBuscarLabel}"
                                         AutomationProperties.AcceleratorKey="Ctrl+F"
                                         TextChanged="TxtBuscar_TextChanged">
                                    <TextBox.KeyboardAccelerators>
                                        <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="SearchAccelerator_Invoked" />
                                    </TextBox.KeyboardAccelerators>
                                </TextBox>
                            </StackPanel>
                        </local:WrapPanel>
                        <!-- Panel de información del paquete seleccionado. Siempre visible y con alto fijo: al
                             aparecer solo al seleccionar, empujaba la tabla 36 px hacia abajo (F-10). Sin selección
                             muestra la indicación que antes ocupaba una línea propia en la cabecera, así que la
                             misma frase no aparece dos veces. El alto mínimo es el que tiene con enlaces. -->
                        <Border x:Name="panelPackageInfo"
                                MinHeight="30"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                CornerRadius="{ThemeResource ControlCornerRadius}"
                                Padding="12,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="txtInfoDescripcion"
                                           Grid.Column="0"
                                           Text="Selecciona un programa para ver sus detalles antes de actualizar."
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           TextWrapping="NoWrap"
                                           VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <HyperlinkButton x:Name="lnkHomepage"
                                                     Content="Página web"
                                                     Padding="4,0"
                                                     FontSize="12"
                                                     Visibility="Collapsed" />
                                    <HyperlinkButton x:Name="lnkNotasVersion"
                                                     Content="Notas de versión"
                                                     Padding="4,0"
                                                     FontSize="12"
                                                     Visibility="Collapsed" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Main Split: DataGrid + Log -->
                <Grid Grid.Row="4" Margin="0,0,0,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="2*" MinHeight="160" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="120" />
                    </Grid.RowDefinitions>

                    <!-- Updates DataGrid Card -->
                    <Border Grid.Row="0" Style="{StaticResource TableCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="txtUpdatesHeader"
                                       Grid.Row="0"
                                       Text="Actualizaciones disponibles"
                                       Style="{StaticResource BodyStrongTextBlockStyle}"
                                       Margin="4,0,0,8" />

                            <!-- Cabecera + filas comparten scroll horizontal (misma anchura mínima) para
                                 que sigan alineadas cuando la ventana es más angosta que las columnas
                                 fijas del DataGrid; el ListView conserva su propio scroll vertical. -->
                            <ScrollViewer Grid.Row="1"
                                          x:Name="DataGridScroller"
                                          HorizontalScrollBarVisibility="Auto"
                                          HorizontalScrollMode="Auto"
                                          VerticalScrollBarVisibility="Disabled"
                                          VerticalScrollMode="Disabled">
                                <!-- El Grid toma el ancho del viewport del ScrollViewer (piso MinWidth=780)
                                     para que la columna "Nombre" (*) rellene cuando la ventana es ancha, y
                                     solo aparezca scroll horizontal por debajo de 780px. -->
                                <Grid MinWidth="780"
                                      Width="{Binding ViewportWidth, ElementName=DataGridScroller}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <!-- Column Headers -->
                                    <Grid Grid.Row="0" Style="{StaticResource TableHeaderStyle}" Height="38"
                                          Padding="8,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="54" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="190" />
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="75" />
                                            <ColumnDefinition Width="55" />
                                        </Grid.ColumnDefinitions>
                                        <!-- Marcar/desmarcar todas las filas visibles. Es tri-estado solo para
                                             poder MOSTRAR una selección parcial; el clic del usuario nunca deja
                                             el estado indeterminado (ver ChkSelectAll_Click). -->
                                        <CheckBox x:Name="chkSelectAll"
                                                  Grid.Column="0"
                                                  MinWidth="0"
                                                  IsThreeState="True"
                                                  IsEnabled="False"
                                                  VerticalAlignment="Center"
                                                  AutomationProperties.AcceleratorKey="Ctrl+A"
                                                  Click="ChkSelectAll_Click">
                                            <CheckBox.KeyboardAccelerators>
                                                <KeyboardAccelerator Key="A" Modifiers="Control" Invoked="SelectAllAccelerator_Invoked" />
                                            </CheckBox.KeyboardAccelerators>
                                        </CheckBox>
                                        <!-- Sortable header cells -->
                                        <Button x:Name="btnColNombre" Grid.Column="1" Tag="1"
                                                Style="{StaticResource ColumnHeaderButtonStyle}" Click="SortHeader_Click">
                                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                <TextBlock x:Name="colNombre" Text="Nombre" FontWeight="SemiBold" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock x:Name="sortNombre" Text="" FontSize="9" VerticalAlignment="Center"
                                                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="btnColId" Grid.Column="2" Tag="2"
                                                Style="{StaticResource ColumnHeaderButtonStyle}" Click="SortHeader_Click">
                                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                <TextBlock x:Name="colId" Text="Id" FontWeight="SemiBold" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock x:Name="sortId" Text="" FontSize="9" VerticalAlignment="Center"
                                                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="btnColVersion" Grid.Column="3" Tag="3"
                                                Style="{StaticResource ColumnHeaderButtonStyle}" Click="SortHeader_Click">
                                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                <TextBlock x:Name="colVersion" Text="Versión" FontWeight="SemiBold" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock x:Name="sortVersion" Text="" FontSize="9" VerticalAlignment="Center"
                                                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="btnColDisponible" Grid.Column="4" Tag="4"
                                                Style="{StaticResource ColumnHeaderButtonStyle}" Click="SortHeader_Click">
                                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                <TextBlock x:Name="colDisponible" Text="Disponible" FontWeight="SemiBold" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock x:Name="sortAvailable" Text="" FontSize="9" VerticalAlignment="Center"
                                                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="btnColFuente" Grid.Column="5" Tag="5"
                                                Style="{StaticResource ColumnHeaderButtonStyle}" Click="SortHeader_Click">
                                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                <TextBlock x:Name="colFuente" Text="Fuente" FontWeight="SemiBold" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock x:Name="sortSource" Text="" FontSize="9" VerticalAlignment="Center"
                                                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                            </StackPanel>
                                        </Button>
                                        <TextBlock x:Name="colExcl" Grid.Column="6" Text="Excl." VerticalAlignment="Center" FontWeight="SemiBold" Margin="8,0,0,0"
                                                   TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Text, ElementName=colExcl}" />
                                    </Grid>

                                    <ListView x:Name="lvPackages" ItemContainerStyle="{StaticResource TableRowContainerStyle}"
                                              Grid.Row="1"
                                              SelectionMode="Single"
                                              SelectionChanged="LvPackages_SelectionChanged"
                                              ContextRequested="LvPackages_ContextRequested"
                                              KeyboardAcceleratorPlacementMode="Hidden">
                                        <!-- Supr excluye la fila resaltada. Sin tooltip sobre toda la tabla: la tecla se
                                             descubre en «Excluir» del menú contextual (KeyboardAcceleratorTextOverride). -->
                                        <ListView.KeyboardAccelerators>
                                            <KeyboardAccelerator Key="Delete" Invoked="ExcludeAccelerator_Invoked" />
                                        </ListView.KeyboardAccelerators>
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Height="36" Padding="8,0"
                                                      AutomationProperties.Name="{Binding RowLabel}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="54" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="190" />
                                                        <ColumnDefinition Width="100" />
                                                        <ColumnDefinition Width="100" />
                                                        <ColumnDefinition Width="75" />
                                                        <ColumnDefinition Width="55" />
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                              IsEnabled="{Binding IsSelectable}"
                                                              VerticalAlignment="Center" MinWidth="0"
                                                              AutomationProperties.Name="{Binding SelectLabel}" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Name}"
                                                               Style="{Binding IsDimmed, Converter={StaticResource PackageCellStyleConverter}}" />
                                                    <TextBlock Grid.Column="2" Text="{Binding Id}"
                                                               Style="{Binding IsDimmed, Converter={StaticResource PackageCellStyleConverter}}" />
                                                    <TextBlock Grid.Column="3" Text="{Binding Version}"
                                                               Style="{Binding IsDimmed, Converter={StaticResource PackageCellStyleConverter}}" />
                                                    <TextBlock Grid.Column="4" Text="{Binding Available}"
                                                               Style="{Binding IsDimmed, Converter={StaticResource PackageCellStyleConverter}}" />
                                                    <TextBlock Grid.Column="5" Text="{Binding Source}"
                                                               Style="{Binding IsDimmed, Converter={StaticResource PackageCellStyleConverter}}" />
                                                    <!-- Ni excluido ni omitido son errores: son decisiones del usuario.
                                                         En rojo (como iba hasta v1.5.0) competían con los fallos reales
                                                         del registro. Gris secundario, coherente con la fila atenuada.
                                                         El glifo distingue los dos estados: bloqueo (excluido, todo el
                                                         paquete, permanente) frente a pausa (versión omitida, temporal). -->
                                                    <FontIcon Grid.Column="6"
                                                              Glyph="{Binding StatusGlyph}"
                                                              FontSize="14"
                                                              VerticalAlignment="Center"
                                                              Margin="8,0,0,0"
                                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                              AutomationProperties.Name="{Binding StatusLabel}"
                                                              ToolTipService.ToolTip="{Binding StatusLabel}"
                                                              Visibility="{Binding HasStatusIcon, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>

                                    <!-- Estado de la tabla: cargando, sin datos todavía, todo al día o
                                         sin coincidencias. Se dibuja ENCIMA del ListView en vez de
                                         sustituirlo: colapsar el ListView lo sacaría del árbol de
                                         automatización, donde lectores de pantalla y tests de UI lo
                                         buscan por AutomationId aunque no tenga filas. -->
                                    <StackPanel x:Name="panelListState"
                                                Grid.Row="1"
                                                Visibility="Collapsed"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                MaxWidth="440"
                                                Spacing="8"
                                                Padding="24">
                                        <ProgressRing x:Name="ringListState"
                                                      IsActive="False"
                                                      Visibility="Collapsed"
                                                      Width="32" Height="32"
                                                      HorizontalAlignment="Center" />
                                        <FontIcon x:Name="iconListState"
                                                  Glyph="&#xE895;"
                                                  FontSize="28"
                                                  HorizontalAlignment="Center"
                                                  Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        <TextBlock x:Name="txtListStateTitle"
                                                   Style="{StaticResource BodyStrongTextBlockStyle}"
                                                   HorizontalAlignment="Center"
                                                   TextAlignment="Center"
                                                   TextWrapping="Wrap" />
                                        <TextBlock x:Name="txtListStateBody"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   HorizontalAlignment="Center"
                                                   TextAlignment="Center"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <!-- Splitter -->
                    <Border Grid.Row="1" Height="6" Background="Transparent" />

                    <!-- Log Card -->
                    <Border Grid.Row="2" Style="{StaticResource TableCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="txtLogHeader" Grid.Row="0"
                                       Text="Actividad y resultados"
                                       Style="{StaticResource BodyStrongTextBlockStyle}"
                                       Margin="4,0,0,8" />
                            <local:ActivityLog x:Name="activityLog"
                                                 Grid.Row="1"
                                                 MaxLines="400" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </ScrollViewer>

        <!-- Barra de estado: anclada al Grid raíz, fuera del ScrollViewer de la página. Mientras una
             operación larga corre, este texto (con velocidad y ETA) y la barra de progreso son lo
             único que el usuario mira; dentro de la página desplazable podían quedar fuera de la
             vista en ventanas bajas o si el usuario subía el scroll. -->
        <Border Grid.Row="2" Style="{StaticResource CompactCardStyle}"
                Margin="16,0,16,16">
            <StackPanel Spacing="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="txtEstado"
                               Grid.Column="0"
                               Text="Listo."
                               Style="{StaticResource BodyStrongTextBlockStyle}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />
                    <ProgressRing x:Name="progressRing"
                                  Grid.Column="1"
                                  IsActive="False"
                                  Width="20" Height="20"
                                  Margin="12,0,0,0" />
                </Grid>
                <ProgressBar x:Name="pbGlobal"
                             Visibility="Collapsed"
                             Minimum="0" Maximum="1"
                             Value="0" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
