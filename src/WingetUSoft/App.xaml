<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="WingetUSoft.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- Estilos compartidos de tarjetas y tablas (F-14). Después de XamlControlsResources, del que
                     toman los pinceles y los radios del sistema. -->
                <ResourceDictionary Source="ms-appx:///UI/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
